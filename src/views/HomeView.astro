---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Rack from '../components/Rack.astro';
import Journal from '../components/Journal.astro';
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} title={t('home.title')} description={t('home.lede')}>
  <PageHead status={t('home.status')} command="cat README.md">
    <Fragment slot="title">{t('home.title1')}<br />{t('home.title2')}</Fragment>
    <p>{t('home.lede')}</p>
  </PageHead>
  <Rack lang={lang} />
  <Journal lang={lang} />
</Base>
