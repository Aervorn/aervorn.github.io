---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LinkCard from '../components/LinkCard.astro';
import { linkCategories, linkTags, type LinkCategory, type LinkTag } from '../data/links';
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const links = (await getCollection('links', ({ id, data }) => id.startsWith(`${lang}/`) && (import.meta.env.DEV || !data.draft)))
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const cats = [...new Set(links.map((l) => l.data.category))] as LinkCategory[];
const tags = (Object.keys(linkTags) as LinkTag[]).filter((tag) => links.some((l) => l.data.tags.includes(tag)));
const count = (n: number) => `${n} ${n > 1 ? t('links.many') : t('links.one')}`;
---
<Base lang={lang} title={t('links.title')} description={t('links.description')} alternates={{ en: '/links', fr: '/fr/liens' }}>
  <PageHead status={t('links.eyebrow')} path={lang === 'fr' ? '~/liens' : '~/links'} command="ls" compact>
    <Fragment slot="title">{t('links.h1')}</Fragment>
    <p>{t('links.intro')}</p>
  </PageHead>

  <section class="tools">
    <div class="wrap">
      {links.length === 0 ? (
        <p class="empty">{t('links.empty')}</p>
      ) : (
        <>
          <div class="filters" hidden data-count-one={t('links.one')} data-count-many={t('links.many')}>
            {cats.length > 1 && (
              <div class="row" role="group" aria-label={t('links.category')} data-group="cat">
                <span class="key">{t('links.category')}</span>
                <button type="button" aria-pressed="true" data-value="all">{t('links.all')}</button>
                {cats.map((c) => <button type="button" aria-pressed="false" data-value={c}>{linkCategories[c].label[lang]}</button>)}
              </div>
            )}
            {tags.length > 1 && (
              <div class="row" role="group" aria-label={t('links.license')} data-group="tag">
                <span class="key">{t('links.license')}</span>
                <button type="button" aria-pressed="true" data-value="all">{t('links.all')}</button>
                {tags.map((tag) => <button type="button" aria-pressed="false" data-value={tag}>{linkTags[tag].label[lang]}</button>)}
              </div>
            )}
          </div>
          <p class="count" aria-live="polite">{count(links.length)}</p>
          <div class="list">
            {links.map((l) => <LinkCard link={l} lang={lang} />)}
          </div>
        </>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-label={t('links.shots')}>
    <button type="button" class="lb-close" aria-label={t('lightbox.close')}>×</button>
    <button type="button" class="lb-nav lb-prev" aria-label={t('lightbox.prev')}>‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="lb-nav lb-next" aria-label={t('lightbox.next')}>›</button>
  </dialog>
</Base>

<script>
  // Filters: hidden without JavaScript, where every card simply stays visible.
  const bar = document.querySelector<HTMLElement>('.filters');
  if (bar) {
    bar.hidden = false;
    const cards = [...document.querySelectorAll<HTMLDetailsElement>('.tools details')];
    const countEl = document.querySelector<HTMLElement>('.count')!;
    const picked: Record<string, string> = { cat: 'all', tag: 'all' };
    const update = () => {
      let n = 0;
      for (const card of cards) {
        const okCat = picked.cat === 'all' || card.dataset.cat === picked.cat;
        const okTag = picked.tag === 'all' || (card.dataset.tags ?? '').split(' ').includes(picked.tag);
        card.hidden = !(okCat && okTag);
        if (!card.hidden) n++;
      }
      countEl.textContent = `${n} ${n > 1 ? bar.dataset.countMany : bar.dataset.countOne}`;
    };
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      const group = btn?.closest<HTMLElement>('[data-group]');
      if (!btn || !group) return;
      picked[group.dataset.group!] = btn.dataset.value!;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      update();
    });
    // Screenshots open in a popup instead of replacing the page.
    // Without JavaScript, the links still open the full image.
    const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = box.querySelector('img')!;
    const caption = box.querySelector('figcaption')!;
    let group: HTMLAnchorElement[] = [];
    let index = 0;
    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const a = group[index];
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = a.dataset.alt ?? '';
      box.classList.toggle('single', group.length < 2);
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!a) return;
      e.preventDefault();
      group = [...a.closest('.shots')!.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
      show(group.indexOf(a));
      box.showModal();
    });
    box.querySelector('.lb-close')!.addEventListener('click', () => box.close());
    box.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    box.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    // A click outside the image (on the dark backdrop) closes the popup
    box.addEventListener('click', (e) => { if (e.target === box || e.target === box.querySelector('figure')) box.close(); });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Opening a card from a link like /links#proxmox-ve
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  }
</script>

<style>
  .tools { padding-bottom: 96px; }
  .filters { display: grid; gap: 10px; margin-bottom: 18px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .key { font-family: var(--mono); font-size: 12px; color: var(--muted); width: 90px; }
  .row button {
    font-family: var(--mono);
    font-size: 13px;
    min-height: 44px;
    padding: 9px 14px;
    border-radius: 8px;
    cursor: pointer;
    background: transparent;
    color: var(--muted);
    border: 1px solid rgba(196, 190, 255, 0.16);
  }
  .row button:hover { color: var(--fg); }
  .row button[aria-pressed='true'] { background: var(--fg); color: var(--ink); border-color: var(--fg); }
  .count { font-family: var(--mono); font-size: 13px; color: var(--muted); margin: 0 0 14px; }
  .list { display: grid; gap: 14px; }
  .empty { font-family: var(--mono); color: var(--muted); }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
  }
  .lightbox[open] { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; }
  .lightbox::backdrop { background: rgba(7, 6, 14, 0.88); backdrop-filter: blur(6px); }
  .lightbox figure { margin: 0; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 56px 8px 24px; }
  .lightbox img { max-width: 100%; max-height: calc(100vh - 120px); object-fit: contain; border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8); }
  .lightbox figcaption { font-family: var(--mono); font-size: 13px; color: var(--muted); text-align: center; }
  .lb-close, .lb-nav {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(196, 190, 255, 0.2);
    background: rgba(19, 18, 31, 0.8);
    color: var(--fg);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  .lb-close:hover, .lb-nav:hover { border-color: var(--teal); color: var(--teal); }
  .lb-close { position: fixed; top: 16px; right: 16px; z-index: 1; }
  .lb-nav { margin: 0 16px; }
  .lightbox.single .lb-nav { visibility: hidden; }
  .shots :global(a) { cursor: zoom-in; }
  @media (max-width: 640px) { .lb-nav { margin: 0 4px; width: 40px; height: 40px; } }
</style>
