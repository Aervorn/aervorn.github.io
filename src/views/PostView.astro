---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { type Post, readingTime, postUrl, getTranslation } from '../utils/posts';
import { categories } from '../data/categories';
import { type Lang, localePath, formatDate } from '../i18n/config';
import { useT } from '../i18n/ui';
import '../styles/prose.css';

interface Props { post: Post; lang: Lang; newer?: Post; older?: Post }
const { post, lang, newer, older } = Astro.props;
const t = useT(lang);
const { Content } = await render(post);
const { title, description, date, updated, category, cover, coverAlt, tags, draft } = post.data;
const minutes = readingTime(post.body);
const other: Lang = lang === 'en' ? 'fr' : 'en';
const translation = await getTranslation(post, other);
---
<Base
  lang={lang}
  title={`${title} · Aervorn`}
  description={description}
  type="article"
  alternates={{ [other]: translation ? postUrl(translation) : null }}
>
  <article style={`--c:var(--cat-${category})`}>
    <header class="wrap head">
      <a class="back" href={localePath(lang, '/blog')}>{t('post.back')}</a>
      <div class="meta">
        <span class="cat">{categories[category].label[lang]}</span>
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        <span>{minutes} {t('post.read')}</span>
        {draft && <span class="draft">{t('post.draft')}</span>}
        {translation && <a class="translation" href={postUrl(translation)} hreflang={other} lang={other}>{t('post.translation')}</a>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    {cover && (
      <figure class="wrap cover">
        <Image src={cover} alt={coverAlt ?? ''} widths={[800, 1200, 1600]} sizes="(max-width: 1000px) 100vw, 1000px" loading="eager" />
      </figure>
    )}

    <div class="wrap">
      <div class="prose" style={`--c:var(--cat-${category})`}>
        <Content />
      </div>

      <footer class="end">
        {updated && <p class="updated">{t('post.updated')} {formatDate(updated, lang)}</p>}
        {tags.length > 0 && <ul class="tags">{tags.map((tag) => <li>#{tag}</li>)}</ul>}
        <nav class="pager" aria-label={t('post.more')}>
          {older ? <a href={postUrl(older)}><span>{t('post.older')}</span>{older.data.title}</a> : <span></span>}
          {newer && <a class="newer" href={postUrl(newer)}><span>{t('post.newer')}</span>{newer.data.title}</a>}
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .head { max-width: calc(760px + 32px); padding-block: 56px 32px; }
  .back { display: inline-block; font-size: 14px; color: var(--muted); text-decoration: none; margin-bottom: 30px; }
  .back:hover { color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  .cat { display: inline-flex; align-items: center; gap: 7px; color: var(--c); }
  .cat::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .draft { color: var(--flux-2); border: 1px dashed currentColor; border-radius: 6px; padding: 1px 6px; text-transform: uppercase; font-size: 11px; }
  .translation { color: var(--fg); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; text-decoration: none; }
  .translation:hover { background: rgba(255, 255, 255, 0.05); }
  h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(38px, 6vw, 64px); line-height: 1.04; letter-spacing: -0.025em; margin: 20px 0 0; text-wrap: balance; }
  .lede { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 2vw, 23px); line-height: 1.45; color: var(--muted); margin: 18px 0 0; }
  .cover { max-width: calc(1000px + 32px); margin: 8px auto 40px; }
  .cover :global(img) { display: block; width: 100%; border-radius: 18px; border: 1px solid var(--line); }
  .end { max-width: 760px; margin: 56px auto 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .updated { color: var(--dim); font-size: 14px; margin: 0 0 14px; }
  .tags { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pager a { display: block; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--line); text-decoration: none; font-family: var(--serif); font-size: 19px; line-height: 1.3; transition: border-color 0.2s, background 0.2s; }
  .pager a:hover { border-color: rgba(196, 190, 255, 0.24); background: rgba(255, 255, 255, 0.03); }
  .pager span { display: block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); margin-bottom: 6px; }
  .pager .newer { text-align: right; grid-column: 2; }
  @media (max-width: 600px) {
    .pager { grid-template-columns: 1fr; }
    .pager .newer { grid-column: auto; text-align: left; }
  }
</style>
