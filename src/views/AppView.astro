---
import Base from '../layouts/Base.astro';
import Threads from '../components/Threads.astro';
import AppWindow from '../components/AppWindow.astro';
import Compatibility from '../components/Compatibility.astro';
import Install from '../components/Install.astro';
import AiNote from '../components/AiNote.astro';
import type { App } from '../data/types';
import { type Lang, localePath } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const t = useT(lang);
const [a, b] = app.accent;
const isMac = app.platform === 'mac';
---
<Base lang={lang} title={`${app.name} · ${app.tagline[lang]}`} description={app.description[lang]} image={`/og/${app.slug}.png`}>
  <section class="hero" style={`--a:${a};--b:${b};--on-a:${app.onAccent ?? '#fff'}`}>
    <Threads />
    <div class="wrap">
      <a class="back" href={localePath(lang, '/#apps')}>{t('app.back')}</a>
      <div class="id">
        <img src={app.icon} alt="" width="96" height="96" />
        <div>
          <h1>{app.name}</h1>
          <p class="tagline">{app.tagline[lang]}</p>
        </div>
      </div>
      <p class="desc">{app.description[lang]}</p>
      <div class="cta">
        {isMac ? (
          <>
            <a class="btn btn-primary dl" href={`${app.repo}/releases/latest`}>{t('app.download')}</a>
            <a class="btn btn-ghost" href={app.repo}>{t('app.source')}</a>
          </>
        ) : (
          <>
            <a class="btn btn-primary dl" href={app.repo}>{t('app.getGithub')}</a>
            <a class="btn btn-ghost" href="#install">{t('app.install')}</a>
          </>
        )}
      </div>
      <dl class="facts">
        {app.facts.map((f) => <div><dt>{f.label[lang]}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section tour">
    <div class="wrap"><AppWindow app={app} lang={lang} /></div>
  </section>

  {app.compatibility && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div><span class="eyebrow">{t('compat.eyebrow')}</span><h2>{t('compat.title')}</h2></div>
          {app.minMacOS && <p>{app.minMacOS} {t('compat.mac')}</p>}
        </div>
        <Compatibility compat={app.compatibility} lang={lang} />
      </div>
    </section>
  )}

  <section class="section" id="install">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">{t('install.eyebrow')}</span><h2>{isMac ? t('install.title') : t('install.server.title')}</h2></div>
        <p>{isMac ? t('install.note') : t('install.server.note')}</p>
      </div>
      <Install app={app} lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap pair">
      <div class="privacy">
        <span class="eyebrow">{t('privacy.eyebrow')}</span>
        <h3>{t('privacy.title')}</h3>
        <p>{app.privacy[lang]}</p>
      </div>
      <AiNote lang={lang} />
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: 56px 40px; }
  .back { display: inline-block; font-size: 14px; color: var(--muted); text-decoration: none; margin-bottom: 28px; }
  .back:hover { color: var(--fg); }
  .id { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .id img { width: 96px; height: 96px; filter: drop-shadow(0 14px 30px color-mix(in srgb, var(--a) 50%, transparent)); }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(48px, 8vw, 88px);
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    background: linear-gradient(100deg, var(--fg) 30%, color-mix(in srgb, var(--a) 70%, var(--fg)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline { margin: 8px 0 0; font-size: clamp(17px, 2vw, 21px); }
  .desc { max-width: 62ch; color: var(--muted); margin: 26px 0 0; font-size: 16.5px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .dl { background: linear-gradient(135deg, var(--a), var(--b)); color: var(--on-a); box-shadow: 0 12px 30px -12px var(--a); }
  .facts {
    display: grid;
    grid-template-columns: repeat(5, auto);
    gap: 1px;
    width: fit-content;
    max-width: 100%;
    margin: 36px 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .facts div { padding: 10px 18px; background: var(--ink); }
  .facts dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); }
  .facts dd { margin: 2px 0 0; font-weight: 600; font-size: 15px; }
  @media (max-width: 640px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .facts div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .tour { padding-top: 24px; }
  #install { scroll-margin-top: 70px; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; align-items: start; }
  @media (max-width: 860px) { .pair { grid-template-columns: 1fr; } }
  .privacy h3 { font-family: var(--display); font-size: 26px; letter-spacing: -0.03em; line-height: 1.1; margin: 12px 0 0; }
  .privacy p { color: var(--muted); margin: 10px 0 0; max-width: 56ch; }
</style>
