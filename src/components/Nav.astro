---
import Logo from './Logo.astro';
import { type Lang, localePath } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { lang: Lang; alternates: Record<Lang, string | null> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'fr' : 'en';
// No translation of this page: send to the home page of the other language
const switchTo = alternates[other] ?? localePath(other, '/');
---
<header class="nav">
  <div class="wrap">
    <a class="brand" href={localePath(lang, '/')} aria-label="Aervorn">
      <Logo />
      Aervorn
    </a>
    <nav aria-label="Main">
      <a href={localePath(lang, '/#apps')}>{t('nav.apps')}</a>
      <a href={localePath(lang, '/blog')}>{t('nav.blog')}</a>
      <a class="gh" href="https://github.com/Aervorn">GitHub</a>
      <a class="lang" href={switchTo} hreflang={other} lang={other} title={t('nav.switch')}>{t('nav.switchShort')}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 9;
    background: rgba(10, 9, 19, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  nav { display: flex; align-items: center; gap: 4px; font-size: 14px; }
  nav a {
    text-decoration: none;
    color: var(--muted);
    padding: 7px 11px;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover { color: var(--fg); background: rgba(255, 255, 255, 0.05); }
  .lang {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 12px;
    border: 1px solid var(--line);
    padding: 5px 10px;
  }
  @media (max-width: 520px) { .gh { display: none; } }
</style>
