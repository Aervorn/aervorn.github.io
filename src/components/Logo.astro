---
// The Aervorn mark: three colored weft threads crossed by two warp threads.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true">
  <rect width="28" height="28" rx="8" fill="#1C1B33" />
  <g stroke-width="2.6" stroke-linecap="round" fill="none">
    <path d="M7 9.5h14" stroke="#A78BFA" />
    <path d="M7 14h14" stroke="#2DD4BF" />
    <path d="M7 18.5h14" stroke="#FF6A3D" />
    <path d="M10 6.5v15" stroke="#EEEBFA" stroke-opacity=".85" />
    <path d="M18 6.5v15" stroke="#EEEBFA" stroke-opacity=".85" />
  </g>
</svg>
