---
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
---
<div class="note">
  <div class="mark" aria-hidden="true">AI</div>
  <div>
    <h3>{t('ai.title')}</h3>
    <p>{t('ai.text')}</p>
  </div>
</div>

<style>
  .note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    padding: 26px 28px;
    border-radius: var(--radius);
    background: var(--loom);
    border: 1px solid var(--line);
  }
  .mark { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--loom-2); font-family: var(--mono); font-size: 13px; color: var(--navloom); }
  h3 { margin: 0; font-family: var(--display); font-size: 20px; letter-spacing: -0.02em; }
  p { margin: 6px 0 0; color: var(--muted); max-width: 72ch; }
  @media (max-width: 520px) { .note { grid-template-columns: 1fr; } }
</style>
