---
// The three sections of the site, drawn as the bays of a server rack.
import { apps } from '../data/apps';
import { type Lang, localePath } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const units = [
  { u: 'U01', name: t('nav.apps'), href: localePath(lang, '/apps'), color: 'var(--navloom)', text: t('rack.apps', { n: String(apps.length), names: apps.map((a) => a.name).join(', ') }) },
  { u: 'U02', name: lang === 'fr' ? 'Liens' : 'Links', href: lang === 'fr' ? '/fr/liens' : '/links', color: 'var(--teal)', text: t('rack.links') },
  { u: 'U03', name: t('nav.blog'), href: localePath(lang, '/blog'), color: 'var(--flux)', text: t('rack.blog') },
];
---
<section class="rack-section">
  <div class="wrap">
    <div class="rack">
      <div class="label"><span>{t('rack.label')}</span><span>homelab-901.fr</span></div>
      {units.map((x) => (
        <a class="unit" href={x.href} style={`--c: ${x.color}`}>
          <span class="u">{x.u}</span>
          <span class="leds" aria-hidden="true"><span></span><span></span></span>
          <span class="name">{x.name}</span>
          <span class="text">{x.text}</span>
          <span class="open">{t('rack.open')}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .rack-section { padding-bottom: 64px; }
  .rack {
    background: #11101c;
    border: 1px solid rgba(196, 190, 255, 0.12);
    border-radius: 18px;
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .label { display: flex; justify-content: space-between; padding: 4px 10px; font-family: var(--mono); font-size: 12px; color: var(--muted); text-transform: uppercase; }
  .unit {
    text-decoration: none;
    background: linear-gradient(180deg, var(--loom-2), #16152a);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 26px 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .unit:hover { border-color: var(--c); transform: translateY(-1px); }
  .u { font-family: var(--mono); font-size: 13px; color: var(--muted); width: 3ch; }
  .leds { display: flex; gap: 6px; }
  .leds span { width: 9px; height: 9px; border-radius: 50%; background: #2a2846; }
  .leds span:first-child { background: var(--c); box-shadow: 0 0 10px var(--c); }
  .name { font-family: var(--display); font-weight: 700; font-size: clamp(32px, 4vw, 44px); letter-spacing: -0.03em; line-height: 1; flex: 0 0 200px; }
  .text { color: var(--muted); flex: 1 1 320px; min-width: 0; }
  .open { font-family: var(--mono); font-size: 14px; color: var(--c); }
  @media (max-width: 640px) { .name { flex-basis: auto; } }
</style>
