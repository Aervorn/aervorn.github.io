---
import type { App } from '../data/types';
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { compat: NonNullable<App['compatibility']>; lang: Lang }
const { compat, lang } = Astro.props;
const t = useT(lang);
---
<div class="scroll">
  <table>
    <thead>
      <tr><th scope="col">{t('compat.browser')}</th>{compat.columns.map((c) => <th scope="col">{c}</th>)}</tr>
    </thead>
    <tbody>
      {compat.rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          {r.cells.map((c) => {
            const yes = c.startsWith('yes');
            const mark = c.slice(yes ? 3 : 2);
            return (
              <td>
                <span class={yes ? 'yes' : 'no'} aria-label={yes ? t('compat.yes') : t('compat.no')}>{yes ? '✓' : '—'}</span>
                {mark && <sup>{mark}</sup>}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
{compat.notes && <ul class="notes">{compat.notes[lang].map((n) => <li>{n}</li>)}</ul>}

<style>
  .scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--loom); }
  table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 640px; }
  th, td { padding: 13px 16px; text-align: center; border-bottom: 1px solid var(--line); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  thead th { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.04em; color: var(--muted); }
  tbody th { text-align: left; font-weight: 500; white-space: nowrap; }
  thead th:first-child { text-align: left; }
  .yes { color: var(--teal); font-weight: 600; }
  .no { color: var(--dim); }
  sup { color: var(--muted); margin-left: 2px; }
  .notes { margin: 14px 0 0; padding: 0; list-style: none; color: var(--dim); font-size: 13.5px; display: grid; gap: 4px; }
</style>
