---
import type { App } from '../data/types';
import type { Lang } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const t = useT(lang);
const vars = { app: app.name };
const isMac = app.platform === 'mac';
const repoDir = app.repo.split('/').pop();
---
<div class="install" style={`--a:${app.accent[0]}`}>
  {isMac ? (
    <>
      <ol class="steps">
        <li><b>{t('install.s1a')}</b> <code>{app.name}-{app.version}.dmg</code> {t('install.s1b')} <a href={`${app.repo}/releases/latest`}>{t('install.s1c')}</a>.</li>
        <li><b>{t('install.s2a')}</b> {t('install.s2b', vars)}</li>
        <li><b>{t('install.s3a')}</b> {t('install.s3b', vars)} <em>{t('install.s3c')}</em> {t('install.s3d')} <em>{t('install.s3e')}</em>.</li>
      </ol>
      <div class="terminal">
        <span>{t('install.terminal')}</span>
        <code>xattr -dr com.apple.quarantine /Applications/{app.name}.app</code>
      </div>
    </>
  ) : (
    <>
      <ol class="steps">
        <li><b>{t('install.server.s1a')}</b> {t('install.server.s1b')}</li>
        <li><b>{t('install.server.s2a')}</b> {t('install.server.s2b')}</li>
        <li><b>{t('install.server.s3a')}</b> {t('install.server.s3b')}</li>
      </ol>
      <div class="terminal block">
        <code>git clone {app.repo}.git<br />cd {repoDir}<br />docker compose -f {app.slug}.yaml up -d</code>
        <a href={`${app.repo}#readme`}>{t('install.server.more')} →</a>
      </div>
    </>
  )}
</div>

<style>
  .install { display: grid; gap: 18px; }
  .steps { counter-reset: s; list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps li {
    counter-increment: s;
    position: relative;
    padding: 22px 22px 22px 64px;
    border-radius: var(--radius);
    background: var(--loom);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 15px;
  }
  .steps li::before {
    content: counter(s);
    position: absolute;
    left: 20px;
    top: 20px;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg);
    background: color-mix(in srgb, var(--a) 30%, transparent);
  }
  .steps b { color: var(--fg); font-weight: 600; }
  .steps em { font-style: normal; color: var(--fg); }
  code { font-family: var(--mono); font-size: 0.88em; color: var(--fg); }
  .terminal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px dashed var(--line);
    font-size: 14px;
    overflow-x: auto;
  }
  .terminal span { font-family: var(--mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dim); }
  .terminal code { white-space: nowrap; }
  .terminal.block { justify-content: space-between; align-items: center; }
  .terminal.block code { line-height: 1.8; }
  .terminal a { color: var(--fg); text-underline-offset: 4px; font-size: 14px; }
</style>
