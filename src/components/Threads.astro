---
// Animated woven threads drawn on a canvas, used behind the hero.
---
<canvas class="threads" aria-hidden="true"></canvas>

<style>
  .threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.9;
    mask-image: radial-gradient(ellipse 80% 75% at 70% 40%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 75% at 70% 40%, #000 25%, transparent 75%);
  }
</style>

<script>
  // Astro bundles this script once, even if the component is used several times.
  const colors = ['#A78BFA', '#60A5FA', '#2DD4BF', '#FFB054', '#FF6A3D', '#E8336B'];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLCanvasElement>('canvas.threads').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    let w = 0, h = 0, t = 0;

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      const gap = 34;
      const n = Math.ceil((w + h) / gap) + 4;
      ctx!.lineWidth = 1.4;
      for (let i = 0; i < n; i++) {
        // Colored weft, going down to the right
        const off = i * gap - h + Math.sin(t * 0.0006 + i * 0.5) * 6;
        const color = colors[i % colors.length];
        const g = ctx!.createLinearGradient(0, 0, w, h);
        g.addColorStop(0, color + '00');
        g.addColorStop(0.5, color + '55');
        g.addColorStop(1, color + '00');
        ctx!.strokeStyle = g;
        ctx!.beginPath();
        ctx!.moveTo(off, 0);
        ctx!.lineTo(off + h, h);
        ctx!.stroke();
        // Pale warp, going down to the left
        const off2 = i * gap + Math.cos(t * 0.0005 + i * 0.7) * 6;
        ctx!.strokeStyle = `rgba(238,235,250,${0.05 + 0.04 * Math.sin(t * 0.001 + i)})`;
        ctx!.beginPath();
        ctx!.moveTo(off2, 0);
        ctx!.lineTo(off2 - h, h);
        ctx!.stroke();
      }
      if (!reduce) {
        t += 16;
        requestAnimationFrame(draw);
      }
    }

    resize();
    addEventListener('resize', resize);
    draw();
  });
</script>
