---
// Posts as a table of contents: date, title, summary, category.
import { type Post, postLang, postUrl } from '../utils/posts';
import { categories } from '../data/categories';
import { type Lang, formatDate } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { posts: Post[]; lang: Lang }
const { posts, lang } = Astro.props;
const t = useT(lang);
---
<ol class="list">
  {posts.map((p) => {
    const pl = postLang(p);
    return (
      <li data-category={p.data.category}>
        <a href={postUrl(p)} hreflang={pl}>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time>
          <div class="text" lang={pl}>
            <h3>
              {p.data.title}
              {pl !== lang && <span class="badge" title={t('post.otherLang')}>{pl.toUpperCase()}</span>}
              {p.data.draft && <span class="badge draft">{t('post.draft')}</span>}
            </h3>
            <p>{p.data.description}</p>
          </div>
          <span class="cat" style={`--c:var(--cat-${p.data.category})`}>{categories[p.data.category].label[lang]}</span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(238, 235, 250, 0.22); }
  li { border-bottom: 1px solid var(--line); }
  li[hidden] { display: none; }
  a {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 28px;
    align-items: baseline;
    padding-block: 24px;
    text-decoration: none;
  }
  time { font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0;
    transition: color 0.2s;
    text-wrap: balance;
  }
  a:hover h3 { color: color-mix(in srgb, var(--navloom) 60%, var(--fg)); }
  p { margin: 6px 0 0; color: var(--muted); font-size: 15px; max-width: 64ch; }
  .cat { display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 12px; color: var(--c); white-space: nowrap; }
  .cat::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .badge {
    margin-left: 10px;
    vertical-align: middle;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .badge.draft { color: var(--flux-2); border: 1px dashed currentColor; }
  @media (max-width: 680px) {
    a { grid-template-columns: 1fr; gap: 6px; }
    .cat, time { order: -1; }
  }
</style>
