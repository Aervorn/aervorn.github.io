---
// Posts as a table of contents: date, title, summary, category.
import type { Post } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { categories } from '../data/categories';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ol class="list">
  {posts.map((p) => (
    <li data-category={p.data.category}>
      <a href={`/blog/${p.id}`}>
        <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        <div class="text">
          <h3>{p.data.title}{p.data.draft && <span class="draft">Draft</span>}</h3>
          <p>{p.data.description}</p>
        </div>
        <span class="cat" style={`--c:var(--cat-${p.data.category})`}>{categories[p.data.category].label}</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(238, 235, 250, 0.22); }
  li { border-bottom: 1px solid var(--line); }
  li[hidden] { display: none; }
  a {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 28px;
    align-items: baseline;
    padding-block: 24px;
    text-decoration: none;
  }
  time { font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0;
    transition: color 0.2s;
    text-wrap: balance;
  }
  a:hover h3 { color: color-mix(in srgb, var(--navloom) 60%, var(--fg)); }
  p { margin: 6px 0 0; color: var(--muted); font-size: 15px; max-width: 64ch; }
  .cat { display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 12px; color: var(--c); white-space: nowrap; }
  .cat::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .draft {
    margin-left: 10px;
    vertical-align: middle;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--flux-2);
    border: 1px dashed currentColor;
    border-radius: 6px;
    padding: 2px 6px;
  }
  @media (max-width: 680px) {
    a { grid-template-columns: 1fr; gap: 6px; }
    .cat { order: -1; }
    time { order: -1; }
  }
</style>
