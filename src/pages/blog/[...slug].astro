---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, formatDate, type Post } from '../../utils/posts';
import { categories } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, category, cover, coverAlt, tags, draft } = post.data;
const minutes = readingTime(post.body);
---
<Base title={`${title} · Aervorn`} description={description} type="article">
  <article style={`--c:var(--cat-${category})`}>
    <header class="wrap head">
      <a class="back" href="/blog">← All posts</a>
      <div class="meta">
        <span class="cat">{categories[category].label}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{minutes} min read</span>
        {draft && <span class="draft">Draft</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    {cover && (
      <figure class="wrap cover">
        <Image src={cover} alt={coverAlt ?? ''} widths={[800, 1200, 1600]} sizes="(max-width: 1000px) 100vw, 1000px" loading="eager" />
      </figure>
    )}

    <div class="wrap">
      <div class="prose">
        <Content />
      </div>

      <footer class="end">
        {updated && <p class="updated">Updated on {formatDate(updated)}</p>}
        {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>#{t}</li>)}</ul>}
        <nav class="pager" aria-label="More posts">
          {older ? <a href={`/blog/${older.id}`}><span>Older</span>{older.data.title}</a> : <span></span>}
          {newer && <a class="newer" href={`/blog/${newer.id}`}><span>Newer</span>{newer.data.title}</a>}
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .head { max-width: calc(760px + 32px); padding-block: 56px 32px; }
  .back { display: inline-block; font-size: 14px; color: var(--muted); text-decoration: none; margin-bottom: 30px; }
  .back:hover { color: var(--fg); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  .cat { display: inline-flex; align-items: center; gap: 7px; color: var(--c); }
  .cat::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .draft { color: var(--flux-2); border: 1px dashed currentColor; border-radius: 6px; padding: 1px 6px; text-transform: uppercase; font-size: 11px; }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 20px 0 0;
    text-wrap: balance;
  }
  .lede { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 2vw, 23px); line-height: 1.45; color: var(--muted); margin: 18px 0 0; }

  .cover { max-width: calc(1000px + 32px); margin: 8px auto 40px; }
  .cover :global(img) { display: block; width: 100%; border-radius: 18px; border: 1px solid var(--line); }

  /* Article text: serif, generous spacing, about 68 characters per line */
  .prose {
    max-width: 760px;
    margin: 0 auto;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.72;
    color: #ddd9ec;
  }
  .prose :global(> * + *) { margin-top: 1.1em; margin-bottom: 0; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(h2),
  .prose :global(h3) { font-family: var(--display); color: var(--fg); letter-spacing: -0.025em; line-height: 1.2; }
  .prose :global(h2) { font-size: 1.5em; font-weight: 700; margin-top: 2em; }
  .prose :global(h3) { font-size: 1.2em; font-weight: 700; margin-top: 1.6em; }
  .prose :global(a) { color: var(--fg); text-decoration-color: color-mix(in srgb, var(--c) 70%, transparent); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  .prose :global(a:hover) { text-decoration-color: var(--c); }
  .prose :global(strong) { color: var(--fg); font-weight: 600; }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(li::marker) { color: var(--c); }
  .prose :global(blockquote) {
    margin-left: 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 2px solid var(--c);
    font-style: italic;
    color: var(--muted);
  }
  .prose :global(hr) { border: 0; height: 1px; background: var(--line); margin-block: 2.4em; }
  .prose :global(img) { display: block; border-radius: 14px; border: 1px solid var(--line); margin-inline: auto; }
  .prose :global(:not(pre) > code) {
    font-family: var(--mono);
    font-size: 0.8em;
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
  }
  .prose :global(pre) {
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.6;
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    overflow-x: auto;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-family: var(--body); font-size: 15px; display: block; overflow-x: auto; }
  .prose :global(th),
  .prose :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .prose :global(th) { color: var(--fg); font-weight: 600; }

  .end { max-width: 760px; margin: 56px auto 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .updated { color: var(--dim); font-size: 14px; margin: 0 0 14px; }
  .tags { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .pager a {
    display: block;
    padding: 18px 20px;
    border-radius: 16px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.3;
    transition: border-color 0.2s, background 0.2s;
  }
  .pager a:hover { border-color: rgba(196, 190, 255, 0.24); background: rgba(255, 255, 255, 0.03); }
  .pager span { display: block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); margin-bottom: 6px; }
  .pager .newer { text-align: right; grid-column: 2; }
  @media (max-width: 600px) {
    .prose { font-size: 18.5px; }
    .pager { grid-template-columns: 1fr; }
    .pager .newer { grid-column: auto; text-align: left; }
  }
</style>
